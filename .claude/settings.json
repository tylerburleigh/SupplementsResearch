{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 wiki/scripts/commit_lint_hook.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 wiki/scripts/lint.py --staleness-only --quiet"
          }
        ]
      }
    ]
  }
}
