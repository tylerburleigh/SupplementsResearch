<?xpacket begin="Ôªø" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="3.1-701">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Acrobat Distiller 7.0 (Windows)</pdf:Producer>
         <pdf:Keywords>prostate cancer, genetic polymorphisms, DNA repair, oxidative stress, serum antioxidant</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:CreateDate>2022-01-13T09:24:07+08:00</xap:CreateDate>
         <xap:ModifyDate>2022-01-13T13:34:05+08:00</xap:ModifyDate>
         <xap:CreatorTool>Arbortext Advanced Print Publisher 10.0.1306/W Unicode</xap:CreatorTool>
         <xap:MetadataDate>2022-01-13T13:34:05+08:00</xap:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Associations Between Polymorphisms in Genes Related to Oxidative Stress and DNA Repair, Interactions With Serum Antioxidants, and Prostate Cancer Risk: Results From the Prostate Cancer Prevention Trial</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Zhihong Gong</rdf:li>
               <rdf:li>Mary E. Platek</rdf:li>
               <rdf:li>Cathee Till</rdf:li>
               <rdf:li>Phyllis J. Goodman</rdf:li>
               <rdf:li>Catherine M. Tangen</rdf:li>
               <rdf:li>Elizabeth A. Platz</rdf:li>
               <rdf:li>Marian L. Neuhouser</rdf:li>
               <rdf:li>Ian M. Thompson</rdf:li>
               <rdf:li>Regina M. Santella</rdf:li>
               <rdf:li>Christine B. Ambrosone</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Study of polymorphisms in genes related to the generation and removal of oxidative stress and repair of oxidative DNA damage will lead to new insights into the genetic basis of prostate cancer.</rdf:li>
