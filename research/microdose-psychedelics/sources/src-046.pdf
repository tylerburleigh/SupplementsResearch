            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Exploring the effect of microdosing psychedelics on creativity in an open-label natural setting</rdf:li>
            </rdf:Alt>
         </dc:title>
